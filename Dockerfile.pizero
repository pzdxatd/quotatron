# Cross-compile production venv for Pi Zero W (ARMv6 / linux/arm/v6).
# Used by scripts/deploy_pi.sh — do not build manually.
#
# uv has no linux/arm/v6 wheel, so we use vanilla pip instead.
# requirements-pi.txt is generated on the host via `uv export` in deploy_pi.sh.
#
# WORKDIR matches the Pi's actual project path so that:
#   - .venv/bin/* shebangs resolve correctly on-device
#   - the editable-install .pth pointer targets the same src/ path we rsync
FROM --platform=linux/arm/v6 python:3.11-slim

# C toolchain needed to compile Pillow, spidev, RPi.GPIO under QEMU
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    gcc \
    libc6-dev \
    zlib1g-dev \
    libjpeg-dev \
    && rm -rf /var/lib/apt/lists/*

# requirements-pi.txt: generated by deploy_pi.sh via `uv export`
COPY requirements-pi.txt /tmp/

WORKDIR /home/pi/quotatron

# Create venv at the path it will occupy on the Pi
RUN python -m venv .venv

# Deps layer: compile C extensions via QEMU (cached after first successful build)
RUN .venv/bin/pip install --no-cache-dir -r /tmp/requirements-pi.txt

# Pure-Python project install — creates .venv/bin/quotatron console script
# and an editable .pth that points to /home/pi/quotatron/src (matches rsync target)
COPY pyproject.toml ./
COPY src/ ./src/
RUN .venv/bin/pip install --no-cache-dir --no-deps -e .
